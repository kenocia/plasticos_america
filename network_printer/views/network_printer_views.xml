<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de lista (list) -->
        <record id="view_network_printer_tree" model="ir.ui.view">
            <field name="name">network.printer.list</field>
            <field name="model">network.printer</field>
            <field name="arch" type="xml">
                <list string="Impresoras en Red" decoration-muted="active == False">
                    <field name="name"/>
                    <field name="ip_address"/>
                    <field name="printer_type"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Vista de formulario -->
        <record id="view_network_printer_form" model="ir.ui.view">
            <field name="name">network.printer.form</field>
            <field name="model">network.printer</field>
            <field name="arch" type="xml">
                <form string="Impresora en Red">
                    <header>
                        <button name="test_connection" string="Probar Conexión" type="object" 
                                class="btn-primary" icon="fa-plug"/>
                        <field name="active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" placeholder="Ej: Impresora Principal"/>
                                <field name="ip_address" placeholder="192.168.1.100"/>
                            </group>
                            <group>
                                <field name="printer_type"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Tipos de Documentos" name="document_types">
                                <group>
                                    <group string="Configuración de Impresión por Tipo de Documento">
                                        <p class="text-muted">
                                            <small>Seleccione qué tipos de documentos imprime esta impresora. 
                                            Esto permite parametrizar qué impresora usar según el tipo de factura.</small>
                                        </p>
                                        <field name="print_invoice_contado" widget="boolean_toggle"/>
                                        <field name="print_invoice_credito" widget="boolean_toggle"/>
                                        <field name="print_credit_note" widget="boolean_toggle"/>
                                    </group>
                                </group>
                                <group>
                                    <p class="text-muted">
                                        <small>
                                            <strong>Nota:</strong> 
                                            <ul>
                                                <li><strong>Facturas al Contado:</strong> Facturas con términos de pago "Contado"</li>
                                                <li><strong>Facturas a Crédito:</strong> Facturas con términos de pago diferentes a "Contado"</li>
                                                <li><strong>Notas de Crédito:</strong> Todas las notas de crédito</li>
                                            </ul>
                                        </small>
                                    </p>
                                </group>
                            </page>
                            <page string="Configuración de Red" name="network_config">
                                <group>
                                    <group string="Protocolo de Impresión">
                                        <field name="print_protocol"/>
                                        <field name="printer_queue_name" 
                                               placeholder="Dejar vacío para usar nombre por defecto"
                                               invisible="print_protocol == 'raw'"/>
                                    </group>
                                </group>
                                <group>
                                    <p class="text-muted">
                                        <small>
                                            <strong>Protocolos disponibles:</strong> 
                                            <ul>
                                                <li><strong>RAW (Puerto 9100):</strong> Para impresoras térmicas que soportan ESC/POS y también para impresoras de inyección de tinta como Canon Pixma. <strong>Recomendado para Canon Pixma.</strong></li>
                                                <li><strong>IPP (Puerto 631):</strong> Internet Printing Protocol. Requiere CUPS configurado en el servidor. Puede no funcionar con Canon Pixma sin CUPS.</li>
                                                <li><strong>LPR (Puerto 515):</strong> Line Printer Remote. Protocolo tradicional para impresoras de red. Alternativa a IPP.</li>
                                            </ul>
                                            <strong>Nota importante:</strong> Para impresoras Canon Pixma conectadas por WiFi, se recomienda usar <strong>RAW</strong> que es más simple y confiable. IPP y LPR pueden requerir configuración adicional de CUPS.
                                        </small>
                                    </p>
                                </group>
                            </page>
                            <page string="Configuración de Papel" name="paper_config">
                                <group>
                                    <group string="Tamaño y Formato">
                                        <field name="paper_width"/>
                                        <field name="character_set"/>
                                        <field name="print_density"/>
                                    </group>
                                    <group string="Opciones de Impresión">
                                        <field name="auto_cut" widget="boolean_toggle"/>
                                        <field name="open_cash_drawer" widget="boolean_toggle"/>
                                        <field name="paper_feed_lines"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Notas" name="notes">
                                <field name="notes" placeholder="Notas adicionales sobre esta impresora..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista de búsqueda -->
        <record id="view_network_printer_search" model="ir.ui.view">
            <field name="name">network.printer.search</field>
            <field name="model">network.printer</field>
            <field name="arch" type="xml">
                <search string="Buscar Impresoras">
                    <field name="name" string="Nombre"/>
                    <field name="ip_address" string="IP"/>
                    <field name="printer_type" string="Tipo"/>
                    <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactivas" name="inactive" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter string="Listín" name="contado" domain="[('printer_type', '=', 'contado')]"/>
                    <filter string="A4 o Carta" name="credito" domain="[('printer_type', '=', 'credito')]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Tipo" name="group_type" context="{'group_by': 'printer_type'}"/>
                        <filter string="Estado" name="group_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Acción para el menú -->
        <record id="action_network_printer" model="ir.actions.act_window">
            <field name="name">Impresoras en Red</field>
            <field name="res_model">network.printer</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{'default_active': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear una nueva impresora en red
                </p>
                <p>
                    Configure las impresoras de red que Odoo utilizará para imprimir documentos.
                    Especifique el nombre, la dirección IP y el tipo de impresora (Crédito o Débito).
                </p>
            </field>
        </record>
    </data>
</odoo>

