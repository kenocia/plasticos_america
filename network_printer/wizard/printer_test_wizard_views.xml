<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista del wizard de prueba -->
        <record id="view_printer_test_wizard_form" model="ir.ui.view">
            <field name="name">network.printer.test.wizard.form</field>
            <field name="model">network.printer.test.wizard</field>
            <field name="arch" type="xml">
                <form string="Prueba de Conexión de Impresora">
                    <sheet>
                        <group>
                            <group>
                                <field name="printer_name" readonly="1"/>
                                <field name="ip_address" readonly="1"/>
                                <field name="test_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="overall_status" widget="badge" 
                                       decoration-success="overall_status == 'success'"
                                       decoration-warning="overall_status == 'warning'"
                                       decoration-danger="overall_status == 'error'"/>
                            </group>
                        </group>
                        
                        <separator string="Resultados de Prueba"/>
                        
                        <group>
                            <group string="Conectividad de Red">
                                <field name="ping_status" widget="text" nolabel="1" 
                                       readonly="1" placeholder="Ejecutando prueba de ping..."/>
                            </group>
                        </group>
                        
                        <group string="Puertos de Impresión">
                            <group>
                                <field name="port_9100_status" readonly="1"/>
                            </group>
                            <group>
                                <field name="port_515_status" readonly="1"/>
                            </group>
                            <group>
                                <field name="port_631_status" readonly="1"/>
                            </group>
                        </group>
                        
                        <separator string="Impresión de Prueba"/>
                        
                        <group>
                            <group>
                                <field name="print_status" widget="text" nolabel="1" 
                                       readonly="1" placeholder="Haga clic en 'Imprimir Documento de Prueba' para enviar un documento de prueba a la impresora..."/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_print_test_document" string="Imprimir Documento de Prueba" 
                                type="object" class="btn-primary" icon="fa-print"/>
                        <button string="Cerrar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Acción para el wizard -->
        <record id="action_printer_test_wizard" model="ir.actions.act_window">
            <field name="name">Prueba de Conexión</field>
            <field name="res_model">network.printer.test.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_network_printer"/>
        </record>
    </data>
</odoo>

