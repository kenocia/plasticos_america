<odoo>
    <record id="view_fuel_vehicle_tree" model="ir.ui.view">
        <field name="name">fuel.vehicle.list</field>
        <field name="model">fuel.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehículos">
                <field name="name"/>
                <field name="plate"/>
                <field name="code"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="year"/>
                <field name="driver_id"/>
                <field name="fuel_type"/>
                <field name="current_odometer"/>
                <field name="expected_efficiency"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fuel_vehicle_form" model="ir.ui.view">
        <field name="name">fuel.vehicle.form</field>
        <field name="model">fuel.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehículo">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <h2>
                            <field name="plate" placeholder="Placa"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="year"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="driver_id"/>
                            <field name="fuel_type"/>
                            <field name="fuel_product_id"/>
                            <field name="analytic_account_id"/>
                            <field name="distance_unit"/>
                            <field name="current_odometer"/>
                            <field name="expected_efficiency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fuel_vehicle_search" model="ir.ui.view">
        <field name="name">fuel.vehicle.search</field>
        <field name="model">fuel.vehicle</field>
        <field name="arch" type="xml">
            <search string="Buscar vehículos">
                <field name="name"/>
                <field name="plate"/>
                <field name="driver_id"/>
                <field name="fuel_type"/>
                <filter string="Activos" name="active" domain="[('active','=',True)]"/>
                <filter string="Inactivos" name="inactive" domain="[('active','=',False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Motorista" name="grp_driver" context="{'group_by':'driver_id'}"/>
                    <filter string="Tipo combustible" name="grp_fuel" context="{'group_by':'fuel_type'}"/>
                    <filter string="Compañía" name="grp_company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fuel_vehicle" model="ir.actions.act_window">
        <field name="name">Vehículos</field>
        <field name="res_model">fuel.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Gestione los vehículos para el control de combustible.</p>
        </field>
    </record>
</odoo>

