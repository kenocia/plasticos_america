<odoo>
    <record id="view_move_form_fuel" model="ir.ui.view">
        <field name="name">account.move.form.fuel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Combustible">
                    <group>
                        <group string="Referencia">
                            <field name="is_fuel_bill"/>
                            <field name="fuel_voucher_id" readonly="1"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                        </group>
                        <group string="Métricas de consumo">
                            <field name="actual_odometer"/>
                            <field name="real_fuel_qty" readonly="1"/>
                            <field name="fuel_product_uom_id" readonly="1" string="Unidad combustible"/>
                            <field name="distance_traveled" readonly="1"/>
                            <field name="fuel_distance_unit" readonly="1" string="Unidad distancia (km/mi)"/>
                            <field name="real_efficiency" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="is_fuel_bill"/>
            </xpath>
        </field>
    </record>
</odoo>

