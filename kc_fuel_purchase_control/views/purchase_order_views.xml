<odoo>
    <record id="view_purchase_order_form_fuel" model="ir.ui.view">
        <field name="name">purchase.order.form.fuel</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group string="Combustible" invisible="not is_fuel_order">
                    <group>
                        <field name="is_fuel_order"/>
                        <field name="fuel_voucher_id" readonly="1"/>
                        <field name="vehicle_id" readonly="1"/>
                        <field name="driver_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="last_odometer" readonly="1"/>
                        <field name="projected_odometer" readonly="1"/>
                        <field name="reason" readonly="1"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//sheet/group/group[1]/field[@name='partner_ref']" position="after">
                <field name="is_fuel_order"/>
            </xpath>
        </field>
    </record>
</odoo>

