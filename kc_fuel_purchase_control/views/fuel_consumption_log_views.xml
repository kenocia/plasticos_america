<odoo>
    <record id="view_fuel_consumption_log_tree" model="ir.ui.view">
        <field name="name">fuel.consumption.log.list</field>
        <field name="model">fuel.consumption.log</field>
        <field name="arch" type="xml">
            <list string="Historial de consumo">
                <field name="name"/>
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="supplier_id"/>
                <field name="fuel_product_id"/>
                <field name="fuel_qty"/>
                <field name="distance_traveled"/>
                <field name="efficiency"/>
                <field name="total_amount"/>
                <field name="analytic_account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fuel_consumption_log_form" model="ir.ui.view">
        <field name="name">fuel.consumption.log.form</field>
        <field name="model">fuel.consumption.log</field>
        <field name="arch" type="xml">
            <form string="Historial de consumo">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <h2>
                            <field name="date" widget="datetime"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Origen">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="voucher_id"/>
                            <field name="purchase_order_id"/>
                            <field name="vendor_bill_id"/>
                        </group>
                        <group string="Vehículo y proveedor">
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="supplier_id"/>
                            <field name="analytic_account_id"/>
                        </group>
                    </group>

                    <group>
                        <group string="Combustible">
                            <field name="fuel_product_id"/>
                            <field name="fuel_qty"/>
                            <field name="uom_id"/>
                            <field name="unit_price"/>
                            <field name="total_amount"/>
                        </group>
                        <group string="Odómetros y rendimiento">
                            <field name="distance_unit" readonly="1"/>
                            <field name="odometer_before"/>
                            <field name="odometer_after"/>
                            <field name="distance_traveled" readonly="1"/>
                            <field name="efficiency" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notas">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fuel_consumption_log_search" model="ir.ui.view">
        <field name="name">fuel.consumption.log.search</field>
        <field name="model">fuel.consumption.log</field>
        <field name="arch" type="xml">
            <search string="Buscar historial de consumo">
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="supplier_id"/>
                <field name="fuel_product_id"/>
                <field name="analytic_account_id"/>
                <field name="date"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Vehículo" name="grp_vehicle" context="{'group_by':'vehicle_id'}"/>
                    <filter string="Motorista" name="grp_driver" context="{'group_by':'driver_id'}"/>
                    <filter string="Proveedor" name="grp_supplier" context="{'group_by':'supplier_id'}"/>
                    <filter string="Mes" name="grp_month" context="{'group_by':'date:month'}"/>
                    <filter string="Cuenta analítica" name="grp_analytic" context="{'group_by':'analytic_account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_fuel_consumption_log_pivot" model="ir.ui.view">
        <field name="name">fuel.consumption.log.pivot</field>
        <field name="model">fuel.consumption.log</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de consumo">
                <field name="total_amount" type="measure"/>
                <field name="fuel_qty" type="measure"/>
                <field name="distance_traveled" type="measure"/>
                <field name="efficiency" type="measure"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="supplier_id"/>
                <field name="fuel_product_id"/>
                <field name="analytic_account_id"/>
                <field name="date" interval="month"/>
            </pivot>
        </field>
    </record>

    <record id="view_fuel_consumption_log_graph" model="ir.ui.view">
        <field name="name">fuel.consumption.log.graph</field>
        <field name="model">fuel.consumption.log</field>
        <field name="arch" type="xml">
            <graph string="Gráfico de consumo" type="line">
                <field name="date" type="row"/>
                <field name="fuel_qty" type="measure"/>
                <field name="distance_traveled" type="measure"/>
                <field name="efficiency" type="measure"/>
                <field name="vehicle_id" type="col"/>
            </graph>
        </field>
    </record>

    <record id="action_fuel_consumption_log" model="ir.actions.act_window">
        <field name="name">Historial de consumo</field>
        <field name="res_model">fuel.consumption.log</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="help" type="html">
            <p>Analice el consumo real de combustible por vehículo, motorista y proveedor.</p>
        </field>
    </record>
</odoo>

