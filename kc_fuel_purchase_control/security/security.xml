<odoo>
    <record id="group_fuel_user" model="res.groups">
        <field name="name">Usuario Combustible</field>
        <field name="category_id" ref="base.module_category_inventory"/>
    </record>

    <record id="group_fuel_manager" model="res.groups">
        <field name="name">Manager Combustible</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('kc_fuel_purchase_control.group_fuel_user'))]"/>
    </record>
</odoo>

