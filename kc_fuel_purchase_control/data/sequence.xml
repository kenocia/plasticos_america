<odoo>
    <record id="seq_fuel_voucher" model="ir.sequence">
        <field name="name">Secuencia Vale Combustible</field>
        <field name="code">fuel.voucher</field>
        <field name="prefix">FUELV/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_fuel_consumption_log" model="ir.sequence">
        <field name="name">Secuencia Historial Consumo</field>
        <field name="code">fuel.consumption.log</field>
        <field name="prefix">FLOG/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

