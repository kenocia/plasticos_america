<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_tablet_wizard_form" model="ir.ui.view">
            <field name="name">mrp.tablet.wizard.form</field>
            <field name="model">mrp.tablet.wizard</field>
            <field name="arch" type="xml">
                <form string="Asistente tablet — Producción por lote">
                    <group invisible="state != 'pin'">
                        <group string="Identificación">
                            <field name="workcenter_id"/>
                            <field name="pin_input" widget="password" placeholder="PIN"/>
                            <field name="state" invisible="1"/>
                        </group>
                    </group>
                    <group invisible="state != 'production'">
                        <group string="Sesión">
                            <field name="employee_id"/>
                            <field name="workcenter_id"/>
                            <field name="state" invisible="1"/>
                        </group>
                        <group string="Orden activa">
                            <field name="production_id"/>
                            <field name="workorder_id" invisible="1"/>
                            <field name="batch_qty"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_validate_pin" string="Entrar" type="object" class="btn-primary" invisible="state != 'pin'"/>
                        <button name="action_create_batch_lot" string="Crear lote" type="object" class="btn-primary" invisible="state != 'production'"/>
                        <button string="Cerrar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
