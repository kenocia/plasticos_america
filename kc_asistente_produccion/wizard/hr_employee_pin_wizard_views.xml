<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_employee_pin_wizard_form" model="ir.ui.view">
            <field name="name">hr.employee.pin.wizard.form</field>
            <field name="model">hr.employee.pin.wizard</field>
            <field name="arch" type="xml">
                <form string="Establecer PIN">
                    <group>
                        <field name="employee_id"/>
                        <field name="pin" widget="password"/>
                        <field name="pin_confirm" widget="password"/>
                    </group>
                    <footer>
                        <button name="action_set_pin" string="Guardar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
