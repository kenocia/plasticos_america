<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_workcenter_form_tablet" model="ir.ui.view">
            <field name="name">mrp.workcenter.form.tablet</field>
            <field name="model">mrp.workcenter</field>
            <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_open_tablet_wizard" type="object" class="oe_stat_button" icon="fa-tablet" string="Asistente tablet"/>
                </xpath>
                <xpath expr="//page[@name='capacity']" position="after">
                    <page string="Tablet / Operaciones" name="tablet">
                        <group string="Asistente tablet">
                            <field name="require_pin"/>
                            <field name="enforce_shift"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
