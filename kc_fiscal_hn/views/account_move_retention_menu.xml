<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_account_move_supplier_retention" model="ir.actions.act_window">
            <field name="name">Comprobante de Retención</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('move_type', '=', 'in_refund')]</field>
            <field name="context">{'default_move_type': 'in_refund', 'display_account_trust': True}</field>
            <field name="limit">80</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Registrar un comprobante de retención de proveedor.
                </p>
            </field>
        </record>

        <record id="action_account_move_supplier_retention_list_view" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
            <field name="act_window_id" ref="action_account_move_supplier_retention"/>
        </record>

        <record id="action_account_move_supplier_retention_form_view" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="account.view_move_form"/>
            <field name="act_window_id" ref="action_account_move_supplier_retention"/>
        </record>

        <!-- TODO: Si se define un diario exclusivo para comprobantes de retención,
             filtrar por journal_id y agregar default_journal_id en el context. -->
        <menuitem id="menu_account_move_supplier_retention"
                  name="Comprobante de Retención"
                  parent="account.menu_finance_payables"
                  action="action_account_move_supplier_retention"
                  sequence="1"/>
    </data>
</odoo>
