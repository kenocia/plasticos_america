<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kc_internal_lot_transfer_wizard_form" model="ir.ui.view">
        <field name="name">kc.internal.lot.transfer.wizard.form</field>
        <field name="model">kc.internal.lot.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transferencia interna GS1" js_class="kc_internal_gs1_scan_wizard">
                <field name="name" invisible="1"/>
                <field name="state" invisible="1"/>
                <field name="session_id" invisible="1"/>
                <field name="scan_count" invisible="1"/>
                <field name="kc_focus_token" invisible="1"/>
                <field name="scan_alert_type" invisible="1"/>
                <field name="message" invisible="1"/>
                <sheet>
                    <group>
                        <group>
                            <field name="picking_type_id"
                                   string="Operación"
                                   required="state != 'done'"
                                   readonly="state == 'done'"
                                   options="{'no_create': True, 'no_open': True}"
                                   class="o_input fs-4"/>
                        </group>
                        <group>
                            <field name="location_id" string="Origen" readonly="1"/>
                            <field name="location_dest_id" string="Destino" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="state == 'done' or not kc_mark_low_quality">
                        <div class="alert alert-warning mb-0 py-2" role="status">
                            <i class="fa fa-exclamation-triangle me-2" title="Baja calidad"/>
                            Esta operación marcará los lotes escaneados como <strong>baja calidad</strong>
                            al validar la transferencia.
                        </div>
                        <field name="kc_mark_low_quality" invisible="1"/>
                    </group>
                    <group invisible="state == 'done'">
                        <label for="barcode_input" string="Escanear QR GS1"/>
                        <field name="barcode_input"
                              string="Escanear QR"
                               nolabel="1"
                               widget="kc_internal_gs1_barcode_scan"
                               default_focus="1"
                               placeholder="Escanee o pegue el código GS1 aquí..."
                               class="o_input fs-3"/>
                    </group>
                    <group string="Resultado del escaneo" invisible="state == 'done'">
                        <field name="scan_result_html" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Lotes escaneados" invisible="scan_count == 0">
                        <field name="line_ids" nolabel="1" readonly="state == 'done'">
                            <list create="false" edit="false" delete="false"
                                  default_order="product_id, lot_id"
                                  decoration-muted="False">
                                <field name="product_id"/>
                                <field name="lot_id"/>
                                <field name="qty" sum="Total"/>
                                <field name="product_uom_id"/>
                                <button name="action_remove_line"
                                        type="object"
                                        icon="fa-trash"
                                        title="Eliminar"
                                        invisible="parent.state == 'done'"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_and_validate_transfer"
                            type="object"
                            string="Crear y Validar Transferencia"
                            class="btn-primary btn-lg"
                            invisible="state == 'done' or scan_count == 0"/>
                    <button name="action_open_picking"
                            type="object"
                            string="Ver transferencia"
                            class="btn-secondary"
                            invisible="state != 'done'"/>
                    <button name="action_close"
                            type="object"
                            string="Cerrar"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kc_internal_lot_transfer_wizard" model="ir.actions.act_window">
        <field name="name">Operaciones internas</field>
        <field name="path">logistics-internos</field>
        <field name="res_model">kc.internal.lot.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">main</field>
    </record>
</odoo>
