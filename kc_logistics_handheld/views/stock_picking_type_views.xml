<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form_inherit_kc_gs1_internal" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.kc.gs1.internal</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general']" position="inside">
                <group string="GS1 Interno"
                       name="kc_gs1_interno"
                       invisible="code != 'internal'">
                    <field name="kc_enable_internal_lot_scanner"/>
                    <field name="kc_mark_low_quality"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
