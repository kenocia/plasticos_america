<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_logistics_handheld" model="ir.ui.view">
        <field name="name">res.users.form.logistics.handheld</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page string="Logística Handheld" name="kc_logistics_handheld">
                    <group string="Operaciones permitidas en app Logística">
                        <field name="kc_logistics_handheld_despachos" widget="boolean_toggle"/>
                        <field name="kc_logistics_handheld_internos" widget="boolean_toggle"/>
                        <field name="kc_logistics_handheld_fisico" widget="boolean_toggle"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_simple_modif_logistics_handheld" model="ir.ui.view">
        <field name="name">res.users.preferences.form.logistics.handheld</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='preferences']" position="after">
                <group string="Logística Handheld" groups="base.group_system">
                    <field name="kc_logistics_handheld_despachos" widget="boolean_toggle"/>
                    <field name="kc_logistics_handheld_internos" widget="boolean_toggle"/>
                    <field name="kc_logistics_handheld_fisico" widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
