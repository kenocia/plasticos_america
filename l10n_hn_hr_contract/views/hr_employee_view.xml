<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!--         EMPLOYEE VIEW DATOS NOMINA        -->
    <record id="hr_employee_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='payroll_date']" position="inside">
                <group name="date_general_payroll">
                    <group string="Datos generales">
                        <field name="date_hired"/>
                        <field name="years_of_service"/>
                        <field name="months_of_service"/>
                        <field name="days_of_service"/>
                        <field name="date_of_stay"/>
                        <field name="previous_days_to_resign"/>
                    </group>
                    <group string="Datos contrato">
                        <field name="contract_type_id"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='job_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
             <xpath expr="//group[@name='departure']" position="after">
                <group name="departure" string="Departure" invisible="not is_low or not active">
                    <field name="is_low"/>
                    <field name="departure_reason_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                    <field name="departure_description"/>
                    <field name="departure_date"/>
                </group>
            </xpath>
        </field>
    </record>

