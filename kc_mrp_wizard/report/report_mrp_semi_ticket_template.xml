<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_mrp_semi_ticket_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <h2>Etiqueta semiterminado: <span t-field="o.name"/></h2>
                        <p class="text-muted small">No es lote de producto terminado en inventario de Odoo; identificador operativo / trazabilidad tablet.</p>
                        <table class="table table-sm">
                            <tr><td>Orden de fabricación</td><td><span t-field="o.production_id.name"/></td></tr>
                            <tr><td>Orden de trabajo / operación</td><td><span t-field="o.workorder_id.name"/> — <span t-field="o.operation_id.name" t-if="o.operation_id"/></td></tr>
                            <tr><td>Centro de trabajo</td><td><span t-field="o.workcenter_id.name"/></td></tr>
                            <tr t-if="o.product_id"><td>Código semiterminado</td><td><span t-field="o.product_id.display_name"/></td></tr>
                            <tr><td>Cantidad</td><td><span t-field="o.quantity"/> <span t-field="o.uom_id.name"/></td></tr>
                            <tr t-if="o.employee_id"><td>Empleado</td><td><span t-field="o.employee_id.name"/></td></tr>
                            <tr><td>Fecha</td><td><span t-field="o.create_date"/></td></tr>
                        </table>
                        <p class="mt-3"><strong>Ref. barras: </strong><span t-esc="o.name"/></p>
                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
