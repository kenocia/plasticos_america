<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_batch_ticket_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <h2>Ticket de lote: <span t-field="o.name"/></h2>
                        <table class="table table-sm">
                            <tr><td>Orden de fabricación</td><td><span t-field="o.production_id.name"/></td></tr>
                            <tr><td>Centro de trabajo</td><td><span t-field="o.workcenter_id.name"/></td></tr>
                            <tr><td>Producto</td><td><span t-field="o.product_id.display_name"/></td></tr>
                            <tr><td>Lote</td><td><span t-field="o.lot_id.name"/></td></tr>
                            <tr><td>Cantidad</td><td><span t-field="o.qty"/> <span t-field="o.product_uom_id.name"/></td></tr>
                            <tr><td>Empleado</td><td><span t-field="o.employee_id.name"/></td></tr>
                            <tr><td>Fecha</td><td><span t-field="o.create_date"/></td></tr>
                        </table>
                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
