<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.rule" id="mrp_batch_ticket_multi_company_rule">
            <field name="name">mrp.batch.ticket multi-company</field>
            <field name="model_id" search="[('model', '=', 'mrp.batch.ticket')]" model="ir.model"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record model="ir.rule" id="mrp_production_stop_type_multi_company_rule">
            <field name="name">mrp.production.stop.type multi-company</field>
            <field name="model_id" search="[('model', '=', 'mrp.production.stop.type')]" model="ir.model"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record model="ir.rule" id="mrp_semi_ticket_multi_company_rule">
            <field name="name">mrp.semi.ticket multi-company</field>
            <field name="model_id" search="[('model', '=', 'mrp.semi.ticket')]" model="ir.model"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record model="ir.rule" id="kc_mrp_production_resin_scrap_multi_company_rule">
            <field name="name">kc.mrp.production.resin.scrap multi-company</field>
            <field name="model_id" search="[('model', '=', 'kc.mrp.production.resin.scrap')]" model="ir.model"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record model="ir.rule" id="kc_mrp_production_semi_adjustment_line_multi_company_rule">
            <field name="name">kc.mrp.production.semi.adjustment.line multi-company</field>
            <field name="model_id" search="[('model', '=', 'kc.mrp.production.semi.adjustment.line')]" model="ir.model"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record model="ir.rule" id="kc_sale_planning_location_multi_company_rule">
            <field name="name">kc.sale.planning.location multi-company</field>
            <field name="model_id" search="[('model', '=', 'kc.sale.planning.location')]" model="ir.model"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
    <!-- Sin noupdate: el dominio debe poder corregirse al actualizar el módulo -->
    <data>
        <record model="ir.rule" id="kc_tablet_res_company_rule">
            <field name="name">Tablet MRP: empresas permitidas del usuario</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="domain_force">['|', ('id', 'in', company_ids), ('id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('kc_mrp_wizard.group_kc_mrp_wizard_user'))]"/>
        </record>
    </data>
</odoo>
