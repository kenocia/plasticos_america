<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kc_mrp_resin_scrap_type_list" model="ir.ui.view">
        <field name="name">kc.mrp.resin.scrap.type.list</field>
        <field name="model">kc.mrp.resin.scrap.type</field>
        <field name="arch" type="xml">
            <list string="Tipos merma material" editable="bottom">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="kc_mrp_resin_scrap_type_form" model="ir.ui.view">
        <field name="name">kc.mrp.resin.scrap.type.form</field>
        <field name="model">kc.mrp.resin.scrap.type</field>
        <field name="arch" type="xml">
            <form string="Tipo merma material">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_kc_mrp_resin_scrap_type" model="ir.actions.act_window">
        <field name="name">Tipos merma de material</field>
        <field name="res_model">kc.mrp.resin.scrap.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
