<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_employee_tablet_security_list" model="ir.ui.view">
            <field name="name">hr.employee.tablet.security.list</field>
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <list string="Permisos MRP por empleado">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="view_hr_employee_tablet_security_form" model="ir.ui.view">
            <field name="name">hr.employee.tablet.security.form</field>
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <form string="Permisos MRP por empleado" create="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="kc_tablet_allow_start" widget="boolean_toggle"/>
                                <field name="kc_tablet_allow_prelabels" widget="boolean_toggle"/>
                                <field name="kc_tablet_allow_scan_prelabel" widget="boolean_toggle"/>
                                <field name="kc_tablet_allow_create_lot" widget="boolean_toggle"/>
                                <field name="kc_tablet_allow_register_semi" widget="boolean_toggle"/>
                                <field name="kc_tablet_allow_reprint_label" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="pin" password="True"/>
                                <field name="kc_tablet_allow_quality_alert" widget="boolean_toggle"/>
                                <field name="kc_tablet_allow_create_bad_lot" widget="boolean_toggle"/>
                                <field name="kc_tablet_allow_selective_manual" widget="boolean_toggle"/>
                                <field name="kc_tablet_allow_pause" widget="boolean_toggle"/>
                                <field name="kc_tablet_allow_finish" widget="boolean_toggle"/>
                                <field name="kc_tablet_allow_material_scrap" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_employee_tablet_security" model="ir.actions.act_window">
            <field name="name">Permisos empleados Asistente MRP</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">list,form</field>
            <!-- view_id solo aplica al primer modo; sin view_ids el form abre la vista estándar de empleado -->
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'sequence': 10, 'view_mode': 'list', 'view_id': ref('view_hr_employee_tablet_security_list')}),
                (0, 0, {'sequence': 20, 'view_mode': 'form', 'view_id': ref('view_hr_employee_tablet_security_form')}),
            ]"/>
            <field name="domain">[('active', '=', True)]</field>
            <field name="context">{'default_kc_tablet_allow_start': True}</field>
        </record>

        <menuitem id="menu_hr_employee_tablet_security"
                  name="Permisos empleados Asistente MRP"
                  parent="menu_tablet_root"
                  action="action_hr_employee_tablet_security"
                  sequence="25"
                  groups="kc_mrp_wizard.group_kc_mrp_wizard_manager"/>
    </data>
</odoo>
