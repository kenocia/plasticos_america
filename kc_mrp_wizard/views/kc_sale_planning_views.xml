<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Compañía: almacenes planificación -->
        <record id="view_company_form_kc_planning" model="ir.ui.view">
            <field name="name">res.company.form.kc.planning</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Kenocia MRP" name="kc_planning">
                        <group>
                            <field name="kc_lote_prefix" string="Prefijo de lote produccion"/>
                        </group>
                        <group colspan="2">
                            <p colspan="2" class="text-muted">
                                Defina una o más ubicaciones internas por tipo. El stock en planificación
                                suma la cantidad disponible (no reservada) en cada ubicación y, si aplica,
                                en sus sububicaciones. Los centros de consumo se vinculan al centro de trabajo.
                            </p>
                        </group>
                        <field name="kc_planning_location_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="usage_type"/>
                                <field name="location_id" options="{'no_create': True}"/>
                                <field name="workcenter_id" optional="show"
                                       invisible="usage_type != 'consumption'"/>
                                <field name="include_child_locations"/>
                                <field name="notes" optional="hide"/>
                                <field name="active" column_invisible="True"/>
                                <field name="company_id" column_invisible="True"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- LdM: componente crítico -->
        <record id="view_mrp_bom_line_list_planning" model="ir.ui.view">
            <field name="name">mrp.bom.form.inherit.planning.critical</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='bom_line_ids']/list//field[@name='product_uom_id']" position="after">
                    <field name="kc_planning_critical_component" string="Crítico planif."/>
                </xpath>
            </field>
        </record>

        <!-- Planificación por producto -->
        <record id="product_product_planning_list" model="ir.ui.view">
            <field name="name">product.product.planning.list</field>
            <field name="model">product.product</field>
            <field name="arch" type="xml">
                <list string="Planificación por producto" create="0" delete="0"
                      decoration-danger="kc_planning_alert_state == 'danger'"
                      decoration-warning="kc_planning_alert_state == 'warning'">
                    <field name="default_code" string="Referencia"/>
                    <field name="name" string="Producto"/>
                    <field name="kc_planning_sale_line_count" string="Líneas"/>
                    <field name="kc_planning_order_count" string="Pedidos"/>
                    <field name="kc_planning_qty_ordered" string="Σ Pedido"/>
                    <field name="kc_planning_qty_to_deliver" string="Σ Saldo entregar"/>
                    <field name="kc_planning_qty_to_invoice" string="Σ Por facturar"/>
                    <field name="kc_planning_mo_produced_qty" string="Σ Producido"/>
                    <field name="kc_planning_qty_to_manufacture" string="Σ Saldo fabricar"/>
                    <field name="kc_planning_mo_open_count" string="OF abiertas"/>
                    <field name="kc_planning_mo_unlinked_qty" string="OF sin pedido"/>
                    <field name="kc_planning_pt_qty_available" string="Stock PT"/>
                    <field name="kc_planning_wip_qty_available" string="Stock WIP" optional="show"/>
                    <field name="kc_planning_mp_product_id" string="MP crítica" optional="show"/>
                    <field name="kc_planning_mp_qty_available" string="Stock MP"/>
                    <field name="kc_planning_alert_state" string="Alerta" widget="badge"
                           decoration-success="kc_planning_alert_state == 'ok'"
                           decoration-warning="kc_planning_alert_state == 'warning'"
                           decoration-danger="kc_planning_alert_state == 'danger'"/>
                    <button name="action_kc_open_sale_planning_lines" type="object"
                            string="Líneas pedido" icon="fa-list" class="btn-link"/>
                </list>
            </field>
        </record>

        <record id="product_product_planning_search" model="ir.ui.view">
            <field name="name">product.product.planning.search</field>
            <field name="model">product.product</field>
            <field name="arch" type="xml">
                <search string="Planificación producto">
                    <field name="name"/>
                    <field name="default_code"/>
                    <filter name="has_sale_demand" string="Con pedido confirmado"
                            domain="[('kc_planning_sale_line_count', '&gt;', 0)]"/>
                    <filter name="alert_danger" string="Faltante"
                            domain="[('kc_planning_alert_state', '=', 'danger')]"/>
                    <filter name="alert_warning" string="Revisar"
                            domain="[('kc_planning_alert_state', '=', 'warning')]"/>
                </search>
            </field>
        </record>

        <record id="product_product_planning_form" model="ir.ui.view">
            <field name="name">product.product.planning.form</field>
            <field name="model">product.product</field>
            <field name="arch" type="xml">
                <form string="Planificación producto" create="0" delete="0">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_kc_open_sale_planning_lines" type="object"
                                    class="oe_stat_button" icon="fa-shopping-cart">
                                <field name="kc_planning_sale_line_count" widget="statinfo" string="Líneas pedido"/>
                            </button>
                            <button name="action_kc_open_planning_mrp_production" type="object"
                                    class="oe_stat_button" icon="fa-wrench"
                                    groups="mrp.group_mrp_user">
                                <field name="kc_planning_mo_count" widget="statinfo" string="OF vinculadas"/>
                            </button>
                        </div>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="default_code" readonly="1"/>
                            <field name="kc_planning_alert_state" widget="badge"/>
                        </group>
                        <group string="Demanda (pedidos confirmados)">
                            <group>
                                <field name="kc_planning_qty_ordered" readonly="1"/>
                                <field name="kc_planning_qty_delivered" readonly="1"/>
                                <field name="kc_planning_qty_to_deliver" readonly="1"/>
                                <field name="kc_planning_qty_to_invoice" readonly="1"/>
                            </group>
                            <group>
                                <field name="kc_planning_mo_produced_qty" readonly="1"/>
                                <field name="kc_planning_qty_to_manufacture" readonly="1"/>
                                <field name="kc_planning_mo_open_count" readonly="1"/>
                                <field name="kc_planning_mo_unlinked_qty" readonly="1"/>
                            </group>
                        </group>
                        <group string="Existencias">
                            <field name="kc_planning_pt_qty_available" readonly="1"/>
                            <field name="kc_planning_wip_qty_available" readonly="1"/>
                            <field name="kc_planning_mp_product_id" readonly="1"/>
                            <field name="kc_planning_mp_qty_available" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_kc_sale_planning_by_product" model="ir.actions.act_window">
            <field name="name">Planificación por producto</field>
            <field name="res_model">product.product</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('product_product_planning_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('product_product_planning_form')}),
            ]"/>
            <field name="search_view_id" ref="product_product_planning_search"/>
            <field name="domain">[('sale_ok', '=', True), ('kc_planning_sale_line_count', '&gt;', 0)]</field>
            <field name="context">{'search_default_has_sale_demand': 1}</field>
        </record>

        <!-- Planificación por línea de pedido -->
        <record id="sale_order_line_planning_list" model="ir.ui.view">
            <field name="name">sale.order.line.planning.list</field>
            <field name="model">sale.order.line</field>
            <field name="arch" type="xml">
                <list string="Planificación por línea de pedido" create="0" delete="0"
                      decoration-danger="kc_planning_alert_state == 'danger'"
                      decoration-warning="kc_planning_alert_state == 'warning'">
                    <field name="order_id" string="Pedido"/>
                    <field name="order_partner_id" string="Cliente"/>
                    <field name="product_id" string="Producto"/>
                    <field name="product_uom_qty" string="Pedido"/>
                    <field name="qty_delivered" string="Entregado"/>
                    <field name="kc_planning_qty_to_deliver" string="Saldo entregar"/>
                    <field name="qty_to_invoice" string="Por facturar"/>
                    <field name="kc_planning_mo_produced_qty" string="Producido OF"/>
                    <field name="kc_planning_qty_to_manufacture" string="Saldo fabricar"/>
                    <field name="kc_planning_mo_open_count" string="OF abiertas"/>
                    <field name="kc_planning_pt_qty_available" string="Stock PT"/>
                    <field name="kc_planning_wip_qty_available" string="Stock WIP" optional="show"/>
                    <field name="kc_planning_mp_product_id" string="MP crítica" optional="show"/>
                    <field name="kc_planning_mp_qty_available" string="Stock MP"/>
                    <field name="kc_planning_alert_state" widget="badge"
                           decoration-success="kc_planning_alert_state == 'ok'"
                           decoration-warning="kc_planning_alert_state == 'warning'"
                           decoration-danger="kc_planning_alert_state == 'danger'"/>
                    <field name="state" column_invisible="1"/>
                    <field name="display_type" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="sale_order_line_planning_search" model="ir.ui.view">
            <field name="name">sale.order.line.planning.search</field>
            <field name="model">sale.order.line</field>
            <field name="arch" type="xml">
                <search string="Planificación líneas">
                    <field name="order_id"/>
                    <field name="order_partner_id"/>
                    <field name="product_id"/>
                    <filter name="confirmed" string="Pedido confirmado"
                            domain="[('state', '=', 'sale')]"/>
                    <filter name="alert_danger" string="Faltante"
                            domain="[('kc_planning_alert_state', '=', 'danger')]"/>
                    <group expand="0" string="Agrupar por">
                        <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                        <filter name="group_order" string="Pedido" context="{'group_by': 'order_id'}"/>
                        <filter name="group_partner" string="Cliente" context="{'group_by': 'order_partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="sale_order_line_planning_form" model="ir.ui.view">
            <field name="name">sale.order.line.planning.form</field>
            <field name="model">sale.order.line</field>
            <field name="arch" type="xml">
                <form string="Línea de pedido (planificación)" create="0" delete="0">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_kc_open_linked_mrp_production" type="object"
                                    class="oe_stat_button" icon="fa-wrench"
                                    groups="mrp.group_mrp_user">
                                <field name="kc_planning_mo_count" widget="statinfo" string="OF"/>
                            </button>
                        </div>
                        <group>
                            <field name="order_id" readonly="1"/>
                            <field name="order_partner_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="kc_planning_alert_state" widget="badge"/>
                        </group>
                        <group string="Cantidades">
                            <group>
                                <field name="product_uom_qty" readonly="1"/>
                                <field name="qty_delivered" readonly="1"/>
                                <field name="kc_planning_qty_to_deliver" readonly="1"/>
                                <field name="qty_to_invoice" readonly="1"/>
                            </group>
                            <group>
                                <field name="kc_planning_mo_produced_qty" readonly="1"/>
                                <field name="kc_planning_qty_to_manufacture" readonly="1"/>
                                <field name="kc_planning_mo_planned_qty" readonly="1"/>
                                <field name="kc_planning_mo_open_count" readonly="1"/>
                            </group>
                        </group>
                        <group string="Existencias">
                            <field name="kc_planning_pt_qty_available" readonly="1"/>
                            <field name="kc_planning_wip_qty_available" readonly="1"/>
                            <field name="kc_planning_mp_product_id" readonly="1"/>
                            <field name="kc_planning_mp_qty_available" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_kc_sale_planning_by_line" model="ir.actions.act_window">
            <field name="name">Planificación por línea de pedido</field>
            <field name="res_model">sale.order.line</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('sale_order_line_planning_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('sale_order_line_planning_form')}),
            ]"/>
            <field name="search_view_id" ref="sale_order_line_planning_search"/>
            <field name="domain">[('state', '=', 'sale'), ('display_type', '=', False), ('product_id', '!=', False)]</field>
            <field name="context">{'search_default_confirmed': 1}</field>
        </record>

        <!-- MO: línea de pedido en formulario -->
        <record id="mrp_production_form_kc_planning" model="ir.ui.view">
            <field name="name">mrp.production.form.kc.planning</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="sale_line_id"
                           groups="sales_team.group_sale_salesman,mrp.group_mrp_user"
                           options="{'no_create': True}"
                           readonly="state in ('done', 'cancel')"
                           domain="[('product_id', '=', product_id), ('state', '=', 'sale')]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
