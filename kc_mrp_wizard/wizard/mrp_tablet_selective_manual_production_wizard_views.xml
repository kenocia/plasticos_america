<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_tablet_selective_manual_production_wizard_form" model="ir.ui.view">
            <field name="name">mrp.tablet.selective.manual.production.wizard.form</field>
            <field name="model">mrp.tablet.selective.manual.production.wizard</field>
            <field name="arch" type="xml">
                <form string="Producción manual (componentes)" class="oe_tablet_wizard_no_nav">
                    <group>
                        <group>
                            <field name="workorder_id" invisible="1"/>
                            <field name="production_id" invisible="1"/>
                            <field name="employee_id" readonly="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="product_id" readonly="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="product_uom_id" readonly="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="qty_to_produce"/>
                            <field name="lot_id" options="{'no_create': True, 'no_open': True}"
                                   placeholder="Lote PT de esta orden"/>
                        </group>
                        <group>
                            <div class="alert alert-secondary mb-0" role="alert">
                                <strong><i class="fa fa-check-square-o me-1"/> Consumo selectivo.</strong><br/>
                                Elija un <strong>lote existente</strong> de la orden y marque qué componentes consumir.
                                La resina (u otros no marcados como opcionales en la LdM) es obligatoria.
                                Bolsa y etiqueta pueden omitirse si en la lista de materiales están como
                                «Opcional en prod. manual (tablet)».
                            </div>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0" class="o_list_no_open">
                            <field name="sequence" column_invisible="1"/>
                            <field name="is_mandatory" column_invisible="1"/>
                            <field name="consume" widget="boolean_toggle" readonly="is_mandatory"/>
                            <field name="product_id" readonly="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="qty_to_consume" readonly="1"/>
                            <field name="product_uom_id" readonly="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="move_id" column_invisible="1"/>
                        </list>
                    </field>
                    <footer class="w-100 oe_tablet_wizard_footer">
                        <div class="d-flex justify-content-center flex-wrap gap-2 w-100">
                            <button string="Cancelar" class="btn-secondary btn-lg py-3" special="cancel"/>
                            <button name="action_confirm" string="Registrar producción" type="object" class="btn-primary btn-lg py-3"/>
                        </div>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
