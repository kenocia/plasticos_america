        <record id="mrp_tablet_wizard_employee_line_kanban" model="ir.ui.view">
            <field name="name">mrp.tablet.wizard.employee.line.kanban</field>
            <field name="model">mrp.tablet.wizard.employee.line</field>
            <field name="arch" type="xml">
                <kanban create="0" delete="0" edit="0" can_open="0" class="oe_tablet_employee_kanban">
                    <field name="employee_wizard_id"/>
                    <field name="employee_id"/>
                    <field name="employee_name"/>
                    <templates>
                        <t t-name="card">
                            <div class="card position-relative h-100 border-0 shadow-sm rounded-3 overflow-hidden text-center py-3">
                                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                                    <div class="mb-2">
                                        <i class="fa fa-user-circle fa-2x text-primary" title="Empleado"/>
                                    </div>
                                    <div class="fw-semibold fs-5">
                                        <field name="employee_name" nolabel="1" class="oe_tablet_employee_name"/>
                                    </div>
                                </div>
                                <!-- Botón transparente que cubre toda la tarjeta: al hacer clic se ejecuta la acción -->
                                <button name="action_select_employee" type="object"
                                        class="position-absolute top-0 start-0 w-100 h-100 border-0 p-0 m-0"
                                        style="z-index: 1; opacity: 0; cursor: pointer;"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="mrp_tablet_employee_wizard_form" model="ir.ui.view">
            <field name="name">mrp.tablet.employee.wizard.form</field>
            <field name="model">mrp.tablet.employee.wizard</field>
            <field name="arch" type="xml">
                <form class="oe_tablet_wizard_no_nav">
                    <group>
                        <group>
                            <field name="workcenter_id" placeholder="Centro de trabajo" readonly="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="allowed_employee_ids" invisible="1"/>
                        </group>
                        <group>
                            <div class="alert alert-info mb-0" role="alert">
                                <strong><i class="fa fa-user me-1"/>Seleccione su empleado para continuar al paso de PIN.</strong><br/>
                            </div>                        
                        </group>
                    </group>
                    <br/>
                    <field name="employee_line_ids" nolabel="1" mode="kanban"
                           view_id="mrp_tablet_wizard_employee_line_kanban"
                           options="{'create': false, 'delete': false, 'edit': false}"/>
                           
                    <footer class="w-100 oe_tablet_wizard_footer">
                        <div class="d-flex justify-content-center flex-wrap gap-2 w-100">
                            <button string="Cancelar" class="btn-secondary btn-lg py-4" special="cancel"/>
                        </div>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Paso 2: PIN del empleado seleccionado -->
        <record id="mrp_tablet_employee_pin_wizard_form" model="ir.ui.view">
            <field name="name">mrp.tablet.employee.pin.wizard.form</field>
            <field name="model">mrp.tablet.employee.wizard</field>
            <field name="arch" type="xml">
                <form class="oe_tablet_wizard_no_nav">
                    <group>
                        <group>
                            <field name="workcenter_id" placeholder="Centro de trabajo" readonly="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="employee_id" string="Empleado" readonly="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="pin_masked" string="PIN" readonly="1"
                                    class="oe_tablet_pin_input oe_tablet_pin_display"/>
                            <field name="pin_input" invisible="1"/>
                        </group>
                        <group>
                            <div class="alert alert-info mb-0" role="alert">
                                <strong><i class="fa fa-lock me-1"/> Ingrese su PIN en el teclado numérico para acceder a producción.</strong><br/>
                            </div>
                        </group>
                    </group>
                    <br/>

                    <div class="oe_tablet_pin_pad">
                        <button type="object" class="btn btn-outline-secondary btn-lg"
                                name="action_pin_add_digit" context="{'pin_digit': '1'}" string="1"/>
                        <button type="object" class="btn btn-outline-secondary btn-lg"
                                name="action_pin_add_digit" context="{'pin_digit': '2'}" string="2"/>
                        <button type="object" class="btn btn-outline-secondary btn-lg"
                                name="action_pin_add_digit" context="{'pin_digit': '3'}" string="3"/>
                        <button type="object" class="btn btn-outline-secondary btn-lg"
                                name="action_pin_add_digit" context="{'pin_digit': '4'}" string="4"/>
                        <button type="object" class="btn btn-outline-secondary btn-lg"
                                name="action_pin_add_digit" context="{'pin_digit': '5'}" string="5"/>
                        <button type="object" class="btn btn-outline-secondary btn-lg"
                                name="action_pin_add_digit" context="{'pin_digit': '6'}" string="6"/>
                        <button type="object" class="btn btn-outline-secondary btn-lg"
                                name="action_pin_add_digit" context="{'pin_digit': '7'}" string="7"/>
                        <button type="object" class="btn btn-outline-secondary btn-lg"
                                name="action_pin_add_digit" context="{'pin_digit': '8'}" string="8"/>
                        <button type="object" class="btn btn-outline-secondary btn-lg"
                                name="action_pin_add_digit" context="{'pin_digit': '9'}" string="9"/>
                        <button type="object" class="btn btn-outline-danger btn-lg"
                                name="action_pin_clear" string="Limpiar"/>
                        <button type="object" class="btn btn-outline-secondary btn-lg"
                                name="action_pin_add_digit" context="{'pin_digit': '0'}" string="0"/>
                        <button type="object" class="btn btn-outline-warning btn-lg"
                                name="action_pin_backspace" string="Borrar"/>
                    </div>
                    <footer class="w-100 oe_tablet_wizard_footer">
                        <div class="d-flex justify-content-center flex-wrap gap-2 w-100">
                            <!-- <button name="action_cancel_pin" string="Volver a centros" type="object"
                                    class="btn-secondary btn-lg py-4"/> -->
                            <button name="action_validate_pin" string="Validar PIN" type="object"
                                    class="btn-primary btn-lg py-4"/>
                        </div>
                    </footer>
                </form>
            </field>
        </record>
