<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_mrp_batch_ticket" model="ir.sequence">
            <field name="name">Ticket lote (tablet)</field>
            <field name="code">mrp.batch.ticket</field>
            <field name="prefix">TKT</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_stock_lot_tablet" model="ir.sequence">
            <field name="name">Lote tablet (producción por fardo)</field>
            <field name="code">stock.lot.tablet</field>
            <field name="prefix">LT</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_mrp_semi_ticket" model="ir.sequence">
            <field name="name">Ticket semiterminado (tablet)</field>
            <field name="code">mrp.semi.ticket</field>
            <field name="prefix">SEM</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
