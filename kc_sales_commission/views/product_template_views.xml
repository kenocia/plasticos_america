<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_commission" model="ir.ui.view">
        <field name="name">product.template.form.commission</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Comisión" name="commission" groups="kc_sales_commission.group_sales_commission_user">
                    <group>
                        <field name="commission_excluded"/>
                    </group>
                    <group string="Comisión específica (opcional)">
                        <field name="commission_use_custom"/>
                        <field name="commission_type" invisible="not commission_use_custom"/>
                        <field name="commission_rate" invisible="not commission_use_custom"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
