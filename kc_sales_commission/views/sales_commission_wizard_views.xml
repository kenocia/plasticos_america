<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kc_sales_commission_wizard_form" model="ir.ui.view">
        <field name="name">kc.sales.commission.wizard.form</field>
        <field name="model">kc.sales.commission.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar comisión">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="employee_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_generate_commission" string="Generar" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kc_sales_commission_wizard" model="ir.actions.act_window">
        <field name="name">Generar Comisión</field>
        <field name="res_model">kc.sales.commission.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
