<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_commission" model="ir.ui.view">
        <field name="name">account.payment.form.commission</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='memo']" position="after">
                <field name="commission_id" readonly="1" groups="kc_sales_commission.group_sales_commission_user"/>
            </xpath>
        </field>
    </record>
</odoo>
