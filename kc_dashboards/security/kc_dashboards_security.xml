<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_kc_dashboards_user" model="res.groups">
        <field name="name">Dashboards KenoCia</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[
            (4, ref('sales_team.group_sale_salesman')),
            (4, ref('sales_team.group_sale_manager')),
            (4, ref('stock.group_stock_user')),
        ]"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_kc_dashboards_user'))]"/>
    </record>

    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_kc_dashboards_user'))]"/>
    </record>
</odoo>
