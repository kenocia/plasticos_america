<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de formulario para res.partner con validación RTN -->
        <record id="view_partner_form_plasticasa" model="ir.ui.view">
            <field name="name">res.partner.form.plasticasa</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='property_stock_supplier']" position="after">
                    <field name="scan_lote_quality_low" string="Entregas lotes baja calidad"/>
                    <field name="delivery_excess_max_percent"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>