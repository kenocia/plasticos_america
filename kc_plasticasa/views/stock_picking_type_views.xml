<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form_inherit_kc_gs1" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.kc.gs1</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general']" position="inside">
                <group string="GS1 Plasticasa"
                       name="kc_gs1_plasticasa"
                       invisible="code not in ['incoming', 'outgoing', 'internal']">
                    <field name="kc_enable_gs1_dispatch_wizard"/>
                    <field name="kc_gs1_block_duplicate_scan"
                           invisible="not kc_enable_gs1_dispatch_wizard"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
