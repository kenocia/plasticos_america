<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_movement_report_wizard_form" model="ir.ui.view">
        <field name="name">product.movement.report.wizard.form</field>
        <field name="model">product.movement.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Productos vendidos (Excel)">
                <sheet>
                    <group>
                        <group string="Filtros">
                            <field name="company_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Opcionales">
                            <field name="partner_id"/>
                            <field name="categ_id"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_export_excel" type="object" string="Exportar Excel" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_movement_report_wizard" model="ir.actions.act_window">
        <field name="name">Productos vendidos (Excel)</field>
        <field name="res_model">product.movement.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_product_movement_report_wizard_form"/>
    </record>

    <menuitem id="menu_product_movement_report_wizard"
              name="Productos vendidos (Excel)"
              parent="sale.menu_sale_report"
              action="action_product_movement_report_wizard"
              sequence="50"/>
</odoo>
