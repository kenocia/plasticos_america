<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kc_lot_label_print_wizard_form" model="ir.ui.view">
        <field name="name">kc.lot.label.print.wizard.form</field>
        <field name="model">kc.lot.label.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Etiqueta Zebra">
                <field name="kc_pdf_visible" invisible="1"/>
                <field name="lock_supplier_profile" invisible="1"/>
                <group>
                    <field name="printer_id" required="1" options="{'no_create': True}"/>
                    <field name="label_profile" readonly="lock_supplier_profile"/>
                    <field name="picking_id" invisible="label_profile != 'supplier'" readonly="1"/>
                    <field name="lot_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <footer>
                    <button name="action_print_zebra" type="object" string="Enviar a impresora" class="btn-primary"/>
                    <button name="action_open_pdf_label" type="object" string="Abrir PDF (un lote)" class="btn-secondary"
                            invisible="not kc_pdf_visible"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
