<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kc_net_sales_report_wizard_form" model="ir.ui.view">
        <field name="name">kc.net.sales.report.wizard.form</field>
        <field name="model">kc.net.sales.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Ventas netas (Excel)">
                <sheet>
                    <group>
                        <group string="Periodo (solo Detalle Ventas)">
                            <field name="company_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Filtros opcionales">
                            <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="categ_ids" widget="many2many_tags"/>
                            <field name="product_ids" widget="many2many_tags"/>
                            <field name="invoice_user_id"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        «Facturas» y «Detalle Ventas» usan el rango de fechas del wizard.
                        «Resumen Fiscal» usa una ventana distinta: en un solo año va del 1 de enero
                        al «hasta»; si el rango cruza años, incluye cada año completo involucrado
                        salvo el último (del 1 de enero al «hasta»). Desglose mensual Subtotal / ISV / Total en moneda compañía.
                    </p>
                </sheet>
                <footer>
                    <button name="action_export_excel" type="object" string="Exportar Excel" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kc_net_sales_report_wizard" model="ir.actions.act_window">
        <field name="name">Ventas netas (Excel)</field>
        <field name="res_model">kc.net.sales.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_kc_net_sales_report_wizard_form"/>
    </record>

    <menuitem id="menu_kc_net_sales_report_wizard"
              name="Ventas netas (Excel)"
              parent="account.menu_finance_reports"
              action="action_kc_net_sales_report_wizard"
              sequence="26"
              groups="account.group_account_basic,account.group_account_readonly"/>
</odoo>
